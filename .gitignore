# Signing keystore + build artifacts — never publish these.
# The APK/AAB live on GitHub Releases; the keystore stays private.
release/
*.apk
*.aab
*.keystore

# Local environment for manual packaging runs (unused in GitHub Actions).
# The cron passes the keystore as GitHub Actions secrets; .env is for local use.
.env

# Compiled python
__pycache__/
*.pyc

# Testing
dist/
build/
node_modules/
coverage/

# Misc
Thumbs.db
.DS_Store
.idx/
*.log
