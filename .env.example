# Local env for scripts/package-android.py (manual runs only).
# GitHub Actions passes these as repository secrets; no .env file is needed there.

# Base64 of the Android signing keystore.
ANDROID_KEYSTORE_B64=YOUR_BASE64_KEYSTORE_HERE

# Keystore + key alias password.
ANDROID_KEYSTORE_PASSWORD=YOUR_KEYSTORE_PASSWORD_HERE

# GitHub Personal Access Token with contents:write scope (manual runs only).
GITHUB_TOKEN=YOUR_GITHUB_TOKEN_HERE

# Optional overrides
APP_URL=https://midnightraven9.github.io/bismarck-big-boy-app/
PACKAGE_ID=com.bismarckbigboy.app
APP_VERSION=1.0.0.0
RELEASE_TAG=v1.0.0
APK_SUFFIX=v1.0.0
