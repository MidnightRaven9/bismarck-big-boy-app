# Local env for scripts/package-android.py (for manual runs).
# The cron passes these as GitHub Actions secrets — no .env file needed there.

# Base64 of the Android signing keystore (same as the GitHub secret).
# e.g. MIIEvQIBADANBgkqhkiG9w0BCQEFAASCBKgwggSkAgEAAoIBAQD...
ANDROID_KEYSTORE_B64=
# Keystore + alias password
ANDROID_KEYSTORE_PASSWORD=
# A PAT with "contents: write" for the app repo (manual runs)
GITHUB_TOKEN=
# Optional overrides
APP_URL=https://midnightraven9.github.io/bismarck-big-boy-app/
PACKAGE_ID=com.bismarckbigboy.app
APP_VERSION=1.0.0.0
RELEASE_TAG=v1.0.0
APK_SUFFIX=v1.0.0
